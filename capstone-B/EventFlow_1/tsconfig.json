{
  
  "compilerOptions": 
  {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,

    // Recommended Options
    "strict": true,
  } ,
  "include": ["src"] ,
  "files": ["src/index.ts"]

}
